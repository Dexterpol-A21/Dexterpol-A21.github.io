---
import Layout from '../layouts/Layout.astro';
import { LayoutTextFlip } from '../components/ui/layout-text-flip.tsx';
import { DockNav } from '../components/DockNav.tsx';
import { I18nBoot } from '../components/I18nBoot.tsx';
import { ScrollReveal } from '../components/ScrollReveal.tsx';
import { ArchiveTitleWallSide } from '../components/ArchiveHoverProposals.tsx';
import { SkillsGrid } from '../components/SkillsGrid.tsx';
import { CopyEmailButton } from '../components/CopyEmailButton.tsx';
import { CopyPhoneButton } from '../components/CopyPhoneButton.tsx';
import { allProjects, chromeExtensions } from '../data/projects';
import { certifications, certSections } from '../data/certifications';
import CertThumb from '../components/CertThumb.astro';
---

<Layout title="Paul Eduardo | Desarrollador de Software">
<I18nBoot client:load />
<DockNav client:load />

<!-- HERO -->
<header id="top" class="min-h-[100dvh] h-auto py-16 md:h-[100dvh] md:py-0 flex flex-col justify-center items-center text-center relative z-10 px-0 md:px-6">
  <div class="glow-border bg-white/5 border border-white/10 mb-4 md:mb-8 inline-flex items-center gap-3 px-3.5 md:px-5 py-1.5 md:py-2 rounded-full backdrop-blur-md shadow-[0_4px_24px_-8px_rgba(0,0,0,0.5)]">
    <span data-i18n="hero.hello" class="text-[9px] md:text-[10px] font-display tracking-widest uppercase text-zinc-300">Hola, soy</span>
  </div>

  <h1 class="w-full px-1 md:px-0 text-[clamp(3rem,15.5vw,4.25rem)] sm:text-6xl md:text-8xl lg:text-[7rem] font-display font-semibold tracking-tighter leading-[0.88] text-white mb-0 select-none relative z-10">
    <span class="block">Paul Eduardo</span>
    <LayoutTextFlip
      client:load
      text=""
      words={["Contreras Lobato", "Software Engineer", "Product Engineer", "Solutions Engineer"]}
      duration={3000}
      className="inline-block w-[calc(100%-0.5rem)] md:w-auto max-w-none bg-white text-black mt-2.5 md:mt-4 px-1.5 sm:px-3 md:px-8 pt-2 pb-2.5 md:pt-3 md:pb-4 rounded-xl sm:rounded-2xl md:rounded-[2rem] font-serif-accent leading-none border-0 shadow-none ring-0 focus:ring-0 text-[0.78em] sm:text-[0.85em] md:text-[1em]"
    />
  </h1>

  <div class="max-w-4xl mt-1 flex flex-col items-center w-full px-4 sm:px-6 md:px-0">
    <h2 class="text-lg sm:text-xl md:text-2xl lg:text-3xl text-zinc-300 font-light leading-snug md:leading-relaxed mb-5 px-1 max-w-md sm:max-w-none">
      <span data-i18n="hero.subtitle">Aspirante a Ing. en Sistemas</span> <span data-i18n="hero.subtitleDivider" class="text-zinc-600 font-medium hidden sm:inline">|</span> <span data-i18n="hero.subtitleTail" class="block sm:inline mt-1 sm:mt-0">Construyo productos y soluciones</span>
    </h2>

    <div class="flex flex-col items-center gap-3.5 md:gap-5 mt-0 w-full">
      <div class="flex flex-col sm:flex-row flex-wrap justify-center items-center gap-2.5 md:gap-4 text-zinc-400 font-sans text-[13px] tracking-wide relative z-20 pointer-events-auto w-full">
        <a href="https://maps.app.goo.gl/6pZSBgzSnuih9nGr6" target="_blank" class="glow-border bg-white/5 border border-white/10 inline-flex w-fit items-center gap-2 px-4 py-2 md:px-6 md:py-3 backdrop-blur-md rounded-full text-zinc-300 hover:text-white transition-all duration-500 shadow-[0_4px_24px_-8px_rgba(0,0,0,0.5)]">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
          <span data-i18n="hero.location">Estado de Mexico, Mexico</span>
        </a>
        <CopyPhoneButton client:load />
      </div>

      <div class="flex flex-wrap justify-center items-center gap-2.5 md:gap-4 font-sans text-[12px] md:text-[13px] tracking-[0.08em] uppercase mt-0.5 md:mt-1 relative z-20 pointer-events-auto w-full">
        <a href="mailto:paulconlob@gmail.com" class="flex items-center justify-center gap-2 px-6 md:px-8 py-2.5 md:py-3 text-[12px] md:text-[13px] bg-white text-black font-medium rounded-full transition-all duration-300 shadow-[0_4px_24px_-8px_rgba(255,255,255,0.2)] hover:shadow-[0_0_56px_-4px_rgba(255,255,255,0.8),0_0_100px_-12px_rgba(255,255,255,0.4)] hover:scale-[1.02] active:scale-[0.97]">
          <span data-i18n="hero.cta">Contactar</span>
        </a>
        <a href="/docs/PECL_CV.pdf" download="Paul_Eduardo_Contreras_Lobato_CV.pdf" class="glow-border bg-white/5 border border-white/10 flex items-center justify-center gap-2 px-5 md:px-7 py-2.5 md:py-3 backdrop-blur-md rounded-full text-zinc-300 hover:text-white transition-all duration-500 shadow-[0_4px_24px_-8px_rgba(0,0,0,0.5)] font-medium">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
          <span data-i18n="hero.cv">Descargar CV</span>
        </a>

        <div class="w-px h-6 bg-white/20 mx-1 hidden sm:block"></div>

        <div class="flex justify-center items-center gap-2 md:gap-3 w-full sm:w-auto">
          <a href="https://github.com/Dexterpol-A21" target="_blank" aria-label="GitHub" class="glow-border bg-white/5 border border-white/10 w-10 h-10 md:w-11 md:h-11 flex items-center justify-center rounded-full backdrop-blur-md text-zinc-300 hover:text-white transition-all duration-500 shadow-[0_4px_24px_-8px_rgba(0,0,0,0.5)]">
            <svg width="18" height="18" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </a>
          <a href="https://www.linkedin.com/in/paul-contreras-lobato" target="_blank" aria-label="LinkedIn" class="glow-border bg-white/5 border border-white/10 w-10 h-10 md:w-11 md:h-11 flex items-center justify-center rounded-full backdrop-blur-md text-zinc-300 hover:text-white transition-all duration-500 shadow-[0_4px_24px_-8px_rgba(0,0,0,0.5)]">
            <svg width="16" height="16" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M4.98 3.5c0 1.381-1.11 2.5-2.48 2.5s-2.48-1.119-2.48-2.5c0-1.38 1.11-2.5 2.48-2.5s2.48 1.12 2.48 2.5zm.02 4.5h-5v16h5v-16zm7.982 0h-4.968v16h4.969v-8.399c0-4.67 6.029-5.052 6.029 0v8.399h4.988v-10.131c0-7.88-8.922-7.593-11.018-3.714v-2.155z"/></svg>
          </a>
          <a href="https://www.fiverr.com/s/XLzgZ0G" target="_blank" aria-label="Fiverr" class="glow-border bg-white/5 border border-white/10 w-10 h-10 md:w-11 md:h-11 flex items-center justify-center rounded-full backdrop-blur-md text-zinc-300 hover:text-white transition-all duration-500 shadow-[0_4px_24px_-8px_rgba(0,0,0,0.5)]">
            <svg width="22" height="22" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="10 9 28 29"><path d="M34 36h-6V25h-4v11h-6V25h-4v-6h4.04 c0.37-4.96,3.54-8,8.46-8h2.53v6H26.5c-0.92,0-2.14,0-2.43,2H34V36z"/></svg>
          </a>
          <CopyEmailButton client:load />
        </div>
      </div>
    </div>
  </div>
</header>

<div id="work">
<!-- ARCHIVO — solo móvil -->
<section id="all-projects" class="relative z-10 w-full py-16 sm:py-24 border-t border-white/10 md:hidden">
  <div class="mb-8 sm:mb-10 px-4 sm:px-6 max-w-[1400px] mx-auto">
    <div class="flex items-end justify-between gap-4">
      <div class="flex items-center gap-4 sm:gap-6">
        <div class="w-8 sm:w-12 h-px bg-zinc-700"></div>
        <h2 data-i18n="sections.archive" class="text-4xl font-serif-accent text-zinc-300 tracking-wide">Archivo</h2>
      </div>
      <p data-i18n="sections.swipe" class="text-xs font-display tracking-widest uppercase text-zinc-600 shrink-0">Desliza →</p>
    </div>
  </div>
  <div
    class="archive-rail flex overflow-x-auto pb-6 hide-scrollbar items-stretch overscroll-x-contain snap-x snap-proximity"
  >
    <div class="archive-rail-pad shrink-0" aria-hidden="true"></div>
    {allProjects.map((p, i) => (
      <a
        href={p.link}
        target="_blank"
        rel="noopener noreferrer"
        class:list={[
          "group snap-start shrink-0 w-[82vw] max-w-[320px] sm:w-[380px] sm:max-w-none flex flex-col border border-white/10 bg-white/[0.03] hover:bg-white/[0.05] hover:border-white/20 transition-all duration-500 overflow-hidden",
          i < allProjects.length - 1 && "mr-3 sm:mr-4",
        ]}
      >
        <div class="flex items-center justify-between px-5 pt-4 pb-3 shrink-0">
          <span class="text-xs font-mono text-zinc-600">{String(i + 1).padStart(2, "0")}</span>
          <span class="text-xs font-display tracking-widest uppercase text-zinc-500">{p.linkLabel}</span>
        </div>

        {p.imageMobile ? (
          <img
            src={p.imageMobile}
            alt={p.title}
            class="w-full h-auto block group-hover:opacity-90 transition-opacity duration-500"
            loading="lazy"
          />
        ) : (
          <div
            class="w-full aspect-[16/10] flex items-center justify-center"
            style={`background: radial-gradient(ellipse at 50% 40%, ${p.accent}22, transparent 60%), #050505`}
          >
            <span class="text-5xl font-display font-semibold tracking-tighter text-white/10 select-none">
              {p.title.slice(0, 2).toUpperCase()}
            </span>
          </div>
        )}

        <div class="px-4 sm:px-5 py-4 sm:py-5 mt-auto">
          <h3 class="text-2xl font-display font-semibold tracking-tighter text-white leading-[0.95] mb-2">{p.title}</h3>
          <p class="text-xs font-display tracking-widest uppercase text-zinc-500 mb-2" data-i18n-es={p.role.es} data-i18n-en={p.role.en}>{p.role.es}</p>
          <p class="font-sans text-base font-light text-zinc-400 leading-relaxed line-clamp-2" data-i18n-es={p.desc.es} data-i18n-en={p.desc.en}>{p.desc.es}</p>
        </div>
      </a>
    ))}
    <div class="archive-rail-pad shrink-0" aria-hidden="true"></div>
  </div>
</section>

<!-- MURO — solo escritorio -->
<section id="muro" class="relative z-10 w-full py-24 md:py-32 border-t border-white/10 hidden md:block">
  <div class="px-6 md:px-12 max-w-[1400px] mx-auto">
    <div class="flex items-center gap-6 mb-10">
      <div class="w-12 h-px bg-zinc-700"></div>
      <h2 data-i18n="sections.wall" class="text-4xl font-serif-accent text-zinc-300 tracking-wide">Muro</h2>
    </div>
    <ArchiveTitleWallSide client:load projects={allProjects} />
  </div>
</section>
</div>

<!-- SOBRE MI -->
<section id="about" class="relative z-10 w-full py-16 sm:py-24 border-t border-white/10">
  <div class="px-4 sm:px-6 md:px-12 max-w-[1400px] mx-auto">
    <div class="flex items-center gap-4 sm:gap-6 mb-8 sm:mb-12">
      <div class="w-8 sm:w-12 h-px bg-zinc-700 shrink-0"></div>
      <h2 data-i18n="sections.about" class="text-4xl md:text-4xl font-serif-accent text-zinc-300 tracking-wide">Sobre mi</h2>
    </div>
    <div class="grid md:grid-cols-2 gap-10 md:gap-16 items-start">
      <div class="space-y-6">
        <div class="border border-white/10 bg-white/[0.03] backdrop-blur-md overflow-hidden shadow-[0_4px_24px_-8px_rgba(0,0,0,0.5)]">
          <div class="p-5 sm:p-6 md:p-8 border-b border-white/10">
            <p class="text-xs md:text-[10px] font-display tracking-widest uppercase text-zinc-500 mb-3 leading-relaxed">
              Software Engineer &nbsp;·&nbsp; Product Engineer &nbsp;·&nbsp; Solutions Engineer
            </p>
            <p class="text-xl md:text-xl font-display font-semibold tracking-tight text-white leading-snug">
              Paul Eduardo Contreras Lobato
            </p>
            <p data-i18n="about.location" class="mt-2 text-base md:text-sm font-light text-zinc-500">Estado de Mexico</p>
          </div>
          <div class="grid grid-cols-2 divide-x divide-white/10">
            <div class="p-4 sm:p-5 md:p-6">
              <p data-i18n="about.educationLabel" class="text-xs md:text-[10px] font-display tracking-widest uppercase text-zinc-600 mb-2">Formacion</p>
              <p class="text-base md:text-sm font-light text-zinc-300 leading-snug">
                <span data-i18n="about.education">Ingenieria en Sistemas</span><br />
                <span data-i18n="about.educationMeta">UVM · Dic 2027</span>
              </p>
            </div>
            <div class="p-4 sm:p-5 md:p-6">
              <p data-i18n="about.languagesLabel" class="text-xs md:text-[10px] font-display tracking-widest uppercase text-zinc-600 mb-3">Idiomas</p>
              <div class="flex flex-wrap items-baseline gap-x-4 sm:gap-x-5 gap-y-1">
                <p class="text-xl md:text-xl font-display font-semibold tracking-tight text-white">
                  ES <span data-i18n="about.native" class="text-sm md:text-xs font-light text-zinc-500">nativo</span>
                </p>
                <p class="text-xl md:text-xl font-display font-semibold tracking-tight text-white">
                  EN <span class="text-sm md:text-xs font-light text-zinc-500">C2</span>
                </p>
              </div>
            </div>
          </div>
          <div class="px-4 sm:px-5 md:px-6 py-4 border-t border-white/10">
            <p data-i18n="about.openTo" class="text-sm md:text-[11px] font-light text-zinc-500 leading-relaxed">
              Abierto a roles full-time de Software / Product Engineer · Remoto o hibrido · ES &amp; EN
            </p>
          </div>
        </div>

        <div>
          <p data-i18n="about.skillsLabel" class="text-xs md:text-[10px] font-display tracking-widest uppercase text-zinc-600 mb-4 text-center md:text-left">Habilidades</p>
          <SkillsGrid client:load />
        </div>
      </div>
      <div class="space-y-6 sm:space-y-8">
        <p data-i18n="about.quote" class="text-2xl sm:text-2xl md:text-3xl font-serif-accent text-zinc-300 leading-snug tracking-wide">
          “No existen problemas complejos, solo sistemas esperando la arquitectura correcta.”
        </p>
        <div class="space-y-5 text-zinc-400 text-base sm:text-base md:text-lg font-light leading-relaxed">
          <p data-i18n="about.p1">
            Comence a trabajar en el 2022 en operaciones y atencion al cliente, primero en Telvista y luego manejando expedientes medicos y como interprete bilingue. Toda esa etapa me sirvio muchisimo para dos cosas clave: llevar mi ingles a un nivel cien por ciento profesional y aprender a manejar clientes, procesos estrictos y alta presion. A la par, en 2023 entre a Ingenieria en Sistemas en la UVM, donde estoy proyectado para graduarme en 2027.
          </p>
          <p data-i18n="about.p2">
            Sin embargo, mi enfoque principal ahora mismo es mi carrera. Desde abril de 2025 arranque como freelancer independiente asi como en Fiverr y con mi propia agencia, NoProb. Ahi me he dedicado a construir sitios y sistemas para clientes reales; me encargo de todo, desde entender el brief del cliente hasta hacer el deploy final a produccion. Precisamente esa experiencia de construir y lanzar proyectos reales es lo que me trae aqui, ya que busco consolidarme y seguir creciendo en un rol fijo como Software o Product Engineer.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- EXPERIENCIA -->
<section id="experiencia" class="relative z-10 w-full py-16 sm:py-24 border-t border-white/10">
  <div class="px-4 sm:px-6 md:px-12 max-w-[1400px] mx-auto">
    <div class="flex items-center gap-4 sm:gap-6 mb-4">
      <div class="w-8 sm:w-12 h-px bg-zinc-700 shrink-0"></div>
      <h2 data-i18n="sections.experience" class="text-4xl md:text-4xl font-serif-accent text-zinc-300 tracking-wide">Experiencia</h2>
    </div>
    <p data-i18n="sections.experienceLead" class="mb-10 max-w-2xl text-base md:text-sm font-light text-zinc-500 leading-relaxed">
      Cuatro roles. El de software primero.
    </p>

    <div class="grid lg:grid-cols-3 gap-4 mb-10">
      <article class="lg:col-span-2 border border-white/20 bg-white/[0.04] p-6 md:p-8 flex flex-col">
        <p data-i18n="experience.e1Dates" class="text-xs md:text-[11px] font-mono text-zinc-500 mb-4">Abr 2025 – hoy</p>
        <h3 data-i18n="experience.e1Title" class="text-4xl md:text-4xl font-display font-semibold tracking-tight text-white">Freelance</h3>
        <p data-i18n="experience.e1Role" class="mt-1 text-xs md:text-[10px] font-display tracking-widest uppercase text-zinc-500">Web &amp; Software Engineer</p>
        <p data-i18n="experience.e1Lead" class="mt-5 text-base md:text-base font-light text-zinc-300 leading-relaxed">
          Arquitectura, desarrollo y despliegue de soluciones end-to-end. Transformo logica de negocio en productos digitales escalables y listos para produccion.
        </p>
        <ul class="mt-5 space-y-2.5 text-base md:text-[15px] font-light text-zinc-400 leading-relaxed">
          <li data-i18n="experience.e1b1">— Desarrollo Fullstack &amp; Micro-SaaS: aplicaciones a medida desde la base de datos (Supabase/SQL) hasta la interfaz final de usuario.</li>
          <li data-i18n="experience.e1b2">— Plataformas B2B y landings de alto rendimiento: sitios optimizados para performance y SEO tecnico (Astro/Next.js), enfocados en conversion (CRO) y automatizacion de leads.</li>
          <li data-i18n="experience.e1b3">— Orquestacion de infraestructura: ownership del ciclo de vida del proyecto — despliegues en Cloudflare, DNS y flujos de integracion continua.</li>
          <li data-i18n="experience.e1b4">— AI-Augmented Development: flujos acelerados con herramientas de IA para entregar codigo y resolver arquitecturas complejas mas rapido.</li>
        </ul>
      </article>

      <article class="border border-white/10 p-6 md:p-8 flex flex-col">
        <p data-i18n="experience.e2Dates" class="text-xs md:text-[11px] font-mono text-zinc-600 mb-4">Jul 2025 – hoy</p>
        <h3 data-i18n="experience.e2Title" class="text-2xl md:text-2xl font-display font-semibold text-zinc-200">Interprete bilingue (OPI)</h3>
        <p data-i18n="experience.e2Role" class="mt-1 text-xs md:text-[10px] font-display tracking-widest uppercase text-zinc-600">Human Quality · Language Line Solutions</p>
        <p data-i18n="experience.e2Lead" class="mt-5 text-base md:text-base font-light text-zinc-400 leading-relaxed">
          Interpretacion ES / EN en tiempo real para gobierno y corporativos. Terminologia medica, legal y financiera con protocolos PII.
        </p>
        <ul class="mt-4 space-y-2.5 text-base md:text-[15px] font-light text-zinc-400 leading-relaxed">
          <li data-i18n="experience.e2b1">— 30+ llamadas/dia · 12+ sectores</li>
          <li data-i18n="experience.e2b2">— Emergencias, crisis y CPS con compostura</li>
          <li data-i18n="experience.e2b3">— Confidencialidad y manejo de PII</li>
          <li data-i18n="experience.e2b4">— Manejo de terminologia medica, legal y financiera</li>
        </ul>
        <div class="mt-6 grid grid-cols-3 gap-2 border-t border-white/10 pt-4 mt-auto">
          <div>
            <p class="text-2xl md:text-2xl font-display font-semibold text-zinc-300 tracking-tight">30+</p>
            <p data-i18n="experience.e2StatCalls" class="text-xs md:text-[10px] font-display tracking-widest uppercase text-zinc-600 mt-0.5">llamadas/dia</p>
          </div>
          <div>
            <p class="text-2xl md:text-2xl font-display font-semibold text-zinc-300 tracking-tight">12+</p>
            <p data-i18n="experience.e2StatSectors" class="text-xs md:text-[10px] font-display tracking-widest uppercase text-zinc-600 mt-0.5">sectores</p>
          </div>
          <div>
            <p class="text-2xl md:text-2xl font-display font-semibold text-zinc-300 tracking-tight flex items-center justify-center sm:justify-start gap-1.5">
              <span>ES</span>
              <svg class="w-5 h-5 text-zinc-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 10h14l-4 -4" />
                <path d="M17 14h-14l4 4" />
              </svg>
              <span>EN</span>
            </p>
            <p data-i18n="experience.e2StatRealtime" class="text-xs md:text-[10px] font-display tracking-widest uppercase text-zinc-600 mt-0.5">tiempo real</p>
          </div>
        </div>
      </article>
    </div>

