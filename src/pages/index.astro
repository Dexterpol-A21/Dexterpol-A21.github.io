<!-- CERTIFICACIONES -->
<section id="certificaciones" class="relative z-10 w-full py-16 sm:py-24 border-t border-white/10">
  <div class="px-4 sm:px-6 md:px-12 max-w-[1400px] mx-auto">
    <div class="flex items-center gap-4 sm:gap-6 mb-10">
      <div class="w-8 sm:w-12 h-px bg-zinc-700 shrink-0"></div>
      <h2 data-i18n="sections.certifications" class="text-4xl md:text-4xl font-serif-accent text-zinc-300 tracking-wide">Certificaciones</h2>
    </div>
  </div>

  <div class="space-y-12 md:space-y-14">
    {certSections.map((section) => {
      const items = certifications.filter((c) => c.section === section.id);
      const label =
        section.id === "networking"
          ? "Redes · Cisco CCNA"
          : section.id === "azure"
            ? "Cloud · Microsoft Azure"
            : section.id === "security"
              ? "Ciberseguridad"
              : "Idioma y formacion";
      const lead =
        section.id === "networking"
          ? "Ruta CCNA: Introduction to Networks → Switching/Routing/Wireless → Enterprise."
          : section.id === "azure"
            ? "Fundamentos Azure → infraestructura segura → proteccion de plataforma."
            : section.id === "security"
              ? "Operaciones de seguridad (CyberOps) y awareness de datos."
              : "Ingles C2 (EF SET) y curso academico UVM.";

      return (
        <div>
          <div class="px-4 sm:px-6 md:px-12 max-w-[1400px] mx-auto mb-4 md:mb-5">
            <div class="flex items-center gap-4 mb-2">
              <h3 data-i18n={section.labelKey} class="text-xs md:text-[11px] font-display tracking-widest uppercase text-zinc-400">
                {label}
              </h3>
              <div class="flex-1 h-px bg-white/10"></div>
              <span class="text-xs md:text-[11px] font-mono text-zinc-600">{items.length}</span>
            </div>
            <div class="flex items-end justify-between gap-3">
              <p data-i18n={section.leadKey} class="text-sm md:text-xs font-light text-zinc-600 max-w-xl">
                {lead}
              </p>
              <p data-i18n="sections.swipe" class="md:hidden text-xs font-display tracking-widest uppercase text-zinc-600 shrink-0">
                Desliza →
              </p>
            </div>
          </div>

          {/* Galería horizontal — solo móvil */}
          <div class="md:hidden archive-rail flex overflow-x-auto pb-2 hide-scrollbar items-stretch overscroll-x-contain snap-x snap-proximity">
            <div class="archive-rail-pad shrink-0" aria-hidden="true"></div>
            {items.map((c, i) => (
              <a
                href={c.href}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  "group snap-start shrink-0 w-[78vw] max-w-[300px] flex flex-col border border-white/10 bg-white/[0.03] overflow-hidden shadow-[0_4px_24px_-8px_rgba(0,0,0,0.5)]",
                  i < items.length - 1 && "mr-3",
                ]}
              >
                <div class="aspect-[16/10] overflow-hidden border-b border-white/10 bg-black">
                  <CertThumb
                    src={c.image}
                    alt={c.title}
                    class="opacity-90"
                  />
                </div>
                <div class="p-4 flex flex-col flex-1">
                  <p class="text-xs font-display tracking-widest uppercase text-zinc-600">{c.issuer}</p>
                  <h4 class="mt-1.5 text-lg font-display font-semibold tracking-tight text-white leading-snug">
                    {c.title}
                  </h4>
                  <div class="mt-auto pt-3 flex items-center justify-between gap-2">
                    <span class="text-xs font-mono text-zinc-600">{c.date}</span>
                    <span data-i18n="experience.view" class="text-xs font-display tracking-widest uppercase text-zinc-500">Ver →</span>
                  </div>
                </div>
              </a>
            ))}
            <div class="archive-rail-pad shrink-0" aria-hidden="true"></div>
          </div>

          {/* Grid — escritorio */}
          <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5 px-4 sm:px-6 md:px-12 max-w-[1400px] mx-auto">
            {items.map((c) => (
              <a
                href={c.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group border border-white/10 bg-white/[0.03] overflow-hidden hover:border-white/20 transition-all duration-500 shadow-[0_4px_24px_-8px_rgba(0,0,0,0.5)]"
              >
                <div class="aspect-[16/10] overflow-hidden border-b border-white/10 bg-black">
                  <CertThumb
                    src={c.image}
                    alt={c.title}
                    class="opacity-80 group-hover:opacity-100 group-hover:scale-[1.02] transition-all duration-500"
                  />
                </div>
                <div class="p-4 md:p-5">
                  <p class="text-[10px] font-display tracking-widest uppercase text-zinc-600">{c.issuer}</p>
                  <h4 class="mt-1.5 text-lg font-display font-semibold tracking-tight text-white leading-snug group-hover:text-zinc-100 transition-colors">
                    {c.title}
                  </h4>
                  <div class="mt-3 flex items-center justify-between gap-2">
                    <span class="text-[11px] font-mono text-zinc-600">{c.date}</span>
                    <span data-i18n="experience.view" class="text-[10px] font-display tracking-widest uppercase text-zinc-500 group-hover:text-white transition-colors">Ver →</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      );
    })}
  </div>
</section>

