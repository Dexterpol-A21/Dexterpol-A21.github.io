---
export interface Props {
	text: string;
	href: string;
}

const { text, href } = Astro.props;
---

<a 
	href={href} 
	target="_blank" 
	rel="noopener noreferrer" 
	class="inline-flex items-center justify-center border border-white/20 bg-white/5 hover:bg-white text-zinc-300 hover:text-black transition-all duration-300 px-4 py-2"
>
	{text}
</a>
