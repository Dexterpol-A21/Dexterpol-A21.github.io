---

export interface Props {
title: string;
role: string;
desc: string;
link: string;
tags: string[];
}

const { title, role, desc, link, tags } = Astro.props;
---

<a 
href={link} 
class="glow-border group block bg-white/5 border border-white/10 hover:bg-white/10 hover:border-white/20 transition-all duration-300 p-8 md:p-10 backdrop-blur-sm relative"
>
<div class="flex justify-between items-start mb-6 gap-4">
<h3 class="text-2xl md:text-3xl font-display font-semibold text-white tracking-tight">{title}</h3>
<span class="text-[10px] uppercase tracking-widest font-display text-zinc-400 bg-black/50 px-3 py-1.5 rounded border border-white/10">{role}</span>
</div>

<p class="text-zinc-400 mb-8 leading-relaxed font-light text-lg">
{desc}
</p>

<div class="flex flex-wrap gap-2">
{tags.map(tag => (
<span class="text-xs font-mono-accent tracking-wider uppercase border border-white/10 bg-white/5 px-3 py-1.5 text-zinc-300">
{tag}
</span>
))}
</div>
</a>